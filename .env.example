PORT=5000
# Comma separated list of origins allowed to call this API (your Vite dev URL / production domain)
CORS_ORIGIN=************

# ---------- MongoDB ----------
# Atlas or self-hosted connection string
MONGO_URI=mongodb+srv://AdityaVerma:9634281999Ad@<cluster>/swarnkar_samaj?retryWrites=true&w=majority

# ---------- Auth ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
# Generate this with: npm run hash-password  (paste the plaintext password when prompted)
ADMIN_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash

# ---------- Telegram (photo storage) ----------
# Create a bot with @BotFather, then create a private channel/group and add the bot as admin.
TELEGRAM_BOT_TOKEN=*********
# The chat/channel id photos get sent to (e.g. -1001234567890 for a channel/supergroup)
TELEGRAM_CHAT_ID=**********


# ---------- Google Drive (video storage, via OAuth - your own Google account) ----------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type "Web application"). Add GOOGLE_REDIRECT_URI below to its "Authorized
# redirect URIs" list.
GOOGLE_CLIENT_ID=*************
GOOGLE_CLIENT_SECRET=*****
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Get this by running: npm run google-auth  (one-time, opens a consent URL for
# YOUR Google account, then prints the refresh token to paste here)
GOOGLE_REFRESH_TOKEN=xxxx
# A folder ID in your own Drive where videos get uploaded (copy from its URL).
GOOGLE_DRIVE_FOLDER_ID=1AbCDefGhIJKlmNoPQRstuVWxyz

# ---------- Business rules ----------
# How many months a video stays before it's auto-deleted from Drive + Mongo
VIDEO_RETENTION_MONTHS=4
# Public gallery page sizes (also enforced server-side no matter what the client asks for)
PHOTOS_PAGE_SIZE=10
VIDEOS_PAGE_SIZE=5

# ---------- Temp storage ----------
# Where in-progress chunked uploads are buffered on disk before being pushed to Telegram/Drive
UPLOAD_TMP_DIR=./tmp_uploads
